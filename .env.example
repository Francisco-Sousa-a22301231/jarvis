# Copy to .env and fill in. Or put values in ~/.jarvis/config.toml.

# Phase 1
PICOVOICE_KEY=
ELEVENLABS_KEY=

# Phase 2 LLM calls go through the `claude` CLI (your Max subscription),
# so there is NO ANTHROPIC_API_KEY here. Make sure `claude` is on PATH and
# logged in via `claude login`.

# Phase 2 — required for the Trello agent (optional; agent self-disables if unset)
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
